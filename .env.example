# ==========================================
# CONFIGURAÇÕES DO CONNECTPAY
# ==========================================
CONNECTPAY_API_SECRET=""
# Use a Edge Function do seu proprio projeto Supabase.
CONNECTPAY_WEBHOOK_URL=""

# URL pública do seu site / webhook (sem barra no final)
SITE_BASE_URL=""

# ==========================================
# CONFIGURAÇÕES DO SUPABASE
# ==========================================
# 1. Project URL (URL do Projeto)
SUPABASE_URL=""

# 2. Project API Keys - anon / public (Chave pública para o frontend)
SUPABASE_ANON_KEY=""

# 3. Project API Keys - service_role (Chave secreta de servidor)
SUPABASE_SERVICE_ROLE_KEY=""

# 4. String de Conexão direta com o Banco de Dados PostgreSQL (Opcional)
DATABASE_URL=""

# Somente para comandos locais do Supabase CLI. Nao configure na Vercel.
SUPABASE_ACCESS_TOKEN=""
SUPABASE_DB_PASSWORD=""

# ==========================================
# TRACKING META / FACEBOOK (Pixel & Conversions API)
# ==========================================
# ID do Pixel Meta
META_PIXEL_ID=""
# Token de Acesso da Conversions API (gerado no Gerenciador de Eventos)
META_ACCESS_TOKEN=""

# ==========================================
# OUTRAS CONFIGURAÇÕES
# ==========================================
OPENAI_API_KEY=""
OPENAI_MODEL=""

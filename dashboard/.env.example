# Perfil principal do dashboard
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_publica_anon_ou_publishable

# Segundo perfil, quando houver operação isolada
VITE_TIKTOK_SUPABASE_URL=https://SEGUNDO_PROJECT_REF.supabase.co
VITE_TIKTOK_SUPABASE_ANON_KEY=chave_publica_do_segundo_projeto

# Evolution API is controlled through the local bridge at 127.0.0.1:3210.
# Never expose AUTHENTICATION_API_KEY through a VITE_ variable.

# Copie para .env.local. Nunca versione o arquivo preenchido.

# ConnectPay
CONNECTPAY_API_SECRET=cole_a_chave_bruta_da_conta_deste_projeto
CONNECTPAY_WEBHOOK_TOKEN=gere_um_token_aleatorio_com_ao_menos_32_caracteres
CONNECTPAY_WEBHOOK_URL=https://SEU_PROJECT_REF.supabase.co/functions/v1/connectpay-webhook?token=O_MESMO_TOKEN
CORS_ALLOWED_ORIGINS=https://seu-dominio.com,http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_ou_live_do_novo_projeto
STRIPE_WEBHOOK_SECRET=whsec_do_novo_webhook

# Meta Conversions API
META_PIXEL_ID=id_do_pixel_deste_projeto
META_CAPI_ACCESS_TOKEN=token_da_conversions_api
META_GRAPH_API_VERSION=v23.0
# META_TEST_EVENT_CODE=TEST12345

# UTMIFY
UTMIFY_API_TOKEN=token_da_conta_utmify_deste_projeto

# Dashboard administrativo
DASHBOARD_ALLOWED_ORIGINS=https://seu-dashboard.com,http://localhost:5173
DASHBOARD_ALLOWED_ADMIN_EMAILS=admin@seu-dominio.com
DASHBOARD_META_SUPABASE_URL=https://PROJECT_REF_PRINCIPAL.supabase.co
DASHBOARD_META_SUPABASE_ANON_KEY=chave_publica_do_projeto_principal

# WhatsApp Chat / Evolution API
WHATSAPP_CHAT_INTERNAL_TOKEN=gere_outro_token_aleatorio_com_32_ou_mais_caracteres
EVOLUTION_API_URL=https://sua-evolution-api.example.com
EVOLUTION_API_KEY=chave_privada_da_evolution
EVOLUTION_INSTANCE=nome_da_instancia_deste_projeto
EVOLUTION_WEBHOOK_TOKEN=gere_um_token_exclusivo_para_o_webhook

# Gemini
GEMINI_API_KEY=chave_do_google_ai_studio
GEMINI_MODEL=gemini-2.0-flash

# O Supabase fornece SUPABASE_URL e chaves administrativas às funções hospedadas.
# Para scripts de replay local, configure separadamente e com segurança:
# SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service_role_apenas_no_ambiente_local_seguro
# CONFIRM_REPLAY=YES
# ORDER_IDS=uuid_1,uuid_2
